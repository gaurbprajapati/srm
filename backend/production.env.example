# Production Environment Variables for Render
# Copy these to your Render dashboard environment variables

# Database Configuration (Required)
MONGO_URI2=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-database-name

# JWT Configuration (Required)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-different-from-jwt-secret-for-production
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
NODE_ENV=production
PORT=10000

# Frontend Configuration
FRONTEND_URL=https://campusnexis.netlify.app

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100 